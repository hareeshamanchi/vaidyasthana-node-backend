# Application Server
NODE_ENV=development
PORT=5000
# In local development: http://localhost:3000
# In production on Render: https://vaidyasthana-frontend.onrender.com
CLIENT_URL=https://vaidyasthana-frontend.onrender.com
FRONTEND_URL=https://vaidyasthana-frontend.onrender.com

# MongoDB Database Connection
# Connect using MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaidyasthana?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Azure Blob Storage Configuration (Private Medical Document Storage)
AZURE_STORAGE_ACCOUNT=vaidyasthanastorage1
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=medical-reports

# Azure AI Document Intelligence (OCR & Table/Key-Value Extraction)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure OpenAI Configuration (Clinical Report Explanation & Summarization)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional Azure Key Vault
AZURE_KEY_VAULT_URL=

# Local Ollama AI Engine (Clinical Nutrition Synthesis)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=30000

# ==============================================================================
# Transactional Email Service (Resend - Production Recommended)
# ==============================================================================
# Recommended for production deployments on Render / cloud containers to avoid SMTP timeouts.
# Uses official Resend HTTPS API (outbound port 443).
# Resend API Key (starts with re_...):
# RESEND_API_KEY=re_your_resend_api_key_here
# Resend From Email:
# For development/testing: onboarding@resend.dev (can only send to Resend account owner email)
# For production: "Vaidyasthana Healthcare" <support@yourverifieddomain.com> (requires verified custom domain in Resend)
# RESEND_FROM_EMAIL="Vaidyasthana Healthcare" <onboarding@resend.dev>

# Alternative Email Service (SMTP) Configuration for Local Testing / Legacy Relays
# Option A - Gmail (Requires 16-character Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM="Vaidyasthana Healthcare" <your_email@gmail.com> (Gmail requires From address to match SMTP_USER)
#
# Option B - Brevo / SendGrid / Custom SMTP:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_key
# SMTP_FROM="Vaidyasthana Healthcare" <support@yourverifieddomain.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Vaidyasthana Healthcare" <your_email@gmail.com>

# Real-Time Video Consultation (Jitsi Meet WebRTC Integration)
# For development and prototype evaluation, the public Jitsi service (meet.jit.si) can be used.
# NOTE: The public meet.jit.si service does not provide HIPAA or contractual clinical privacy guarantees.
# For production healthcare deployments, configure a self-hosted Jitsi instance or JaaS with JWT token authentication.
JITSI_DOMAIN=meet.jit.si
VIDEO_ROOM_PREFIX=vaidyasthana-consult

