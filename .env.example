# Application Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
# Connect using MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaidyasthana?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Azure Blob Storage Configuration (Private Medical Document Storage)
AZURE_STORAGE_ACCOUNT=vaidyasthanastorage1
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=medical-reports

# Azure AI Document Intelligence (OCR & Table/Key-Value Extraction)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure OpenAI Configuration (Clinical Report Explanation & Summarization)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional Azure Key Vault
AZURE_KEY_VAULT_URL=

# Local Ollama AI Engine (Clinical Nutrition Synthesis)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=30000

# Email Service (SMTP) Configuration for Password Reset & System Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Vaidyasthana Healthcare" <noreply@vaidyasthana.com>
